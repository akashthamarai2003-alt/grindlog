{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/app",
      "destination": "https://grindlog.in",
      "permanent": false
    },
    {
      "source": "/app/:path*",
      "destination": "https://grindlog.in/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!app).*)",
      "destination": "/index.html"
    }
  ]
}
