{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/app",
      "destination": "https://grindlog-lake.vercel.app",
      "permanent": false
    },
    {
      "source": "/app/:path*",
      "destination": "https://grindlog-lake.vercel.app/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
